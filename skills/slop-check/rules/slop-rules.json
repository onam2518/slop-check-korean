{
  "version": "1.0.0",
  "description": "Machine-readable slop rules for slop-check. Merged from ten anti-slop skills (blader/humanizer, aboudjem/humanizer, aashaexo/soundshuman, ehmo/slopbeth, hardikpandya/stop-slop, petergyang/no-ai-slop, jalaalrd/anti-ai-slop-writing, stephenturner/deslop, cursor/unslop, elithrar/anti-slop). Vocabulary tiers carry the highest consensus weight. sloplint reads this file; edit it to change what fires.",
  "vocabulary": {
    "tier1": {
      "weight": 5,
      "note": "Dead giveaways. Every occurrence flagged.",
      "words": [
        "delve", "delves", "delving", "delved",
        "tapestry", "testament", "pivotal", "intricate", "intricacies",
        "showcase", "showcases", "showcasing", "showcased",
        "foster", "fosters", "fostering", "fostered",
        "garner", "garners", "garnered", "garnering",
        "interplay", "enduring", "vibrant", "crucial",
        "meticulous", "meticulously", "seamless", "seamlessly",
        "groundbreaking", "leverage", "leverages", "leveraging", "leveraged",
        "synergy", "synergies", "transformative", "paramount",
        "multifaceted", "myriad", "cornerstone",
        "empower", "empowers", "empowering", "empowered",
        "catalyst", "catalyze", "catalyzing",
        "nestled", "realm", "bustling", "renowned", "invaluable",
        "actionable", "impactful", "learnings", "robust",
        "embark", "embarks", "embarking", "embarked",
        "underscore", "underscores", "underscoring", "underscored",
        "unparalleled", "ever-evolving", "game-changer", "game-changing",
        "unpack", "unpacks", "unpacking", "supercharge", "quietly"
      ]
    },
    "tier2": {
      "weight": 3,
      "minDistinct": 2,
      "note": "Suspicious in density. Flagged when two or more distinct terms appear.",
      "words": [
        "additionally", "furthermore", "moreover", "notably",
        "consequently", "subsequently", "accordingly", "nonetheless",
        "comprehensive", "paradigm", "holistic", "holistically",
        "utilize", "utilizes", "utilizing", "utilized",
        "facilitate", "facilitates", "facilitating", "facilitated",
        "nuanced", "elucidate", "illuminate",
        "encompass", "encompasses", "encompassing",
        "streamline", "streamlines", "streamlining", "streamlined",
        "spearhead", "spearheading", "bolster", "bolstering", "bolstered",
        "poised", "cutting-edge", "harness", "harnessing", "harnessed",
        "unleash", "unleashing", "revolutionize", "reimagine",
        "elevate", "elevating", "alleviate", "alleviating",
        "cadence", "quintessential", "ubiquitous", "proactive",
        "endeavor", "endeavour", "aforementioned"
      ]
    },
    "tier3": {
      "weight": 1,
      "maxDensityPct": 1.5,
      "note": "Context-dependent. Flagged only when combined density exceeds maxDensityPct per 100 words.",
      "words": [
        "significant", "effective", "unique", "compelling",
        "exceptional", "essential", "valuable", "innovative", "notable", "powerful"
      ]
    }
  },
  "phrases": [
    { "match": "in order to", "fix": "to", "category": "filler", "weight": 3 },
    { "match": "due to the fact that", "fix": "because", "category": "filler", "weight": 3 },
    { "match": "at this point in time", "fix": "now", "category": "filler", "weight": 3 },
    { "match": "in the event that", "fix": "if", "category": "filler", "weight": 3 },
    { "match": "has the ability to", "fix": "can", "category": "filler", "weight": 3 },
    { "match": "have the ability to", "fix": "can", "category": "filler", "weight": 3 },
    { "match": "is able to", "fix": "can", "category": "filler", "weight": 2 },
    { "match": "it is important to note that", "fix": "", "category": "filler", "weight": 4 },
    { "match": "it is worth noting that", "fix": "", "category": "filler", "weight": 4 },
    { "match": "it should be noted that", "fix": "", "category": "filler", "weight": 4 },
    { "match": "at the end of the day", "fix": "", "category": "filler", "weight": 3 },
    { "match": "for the purpose of", "fix": "to", "category": "filler", "weight": 3 },
    { "match": "in light of the fact that", "fix": "because", "category": "filler", "weight": 3 },
    { "match": "the fact that", "fix": "that", "category": "filler", "weight": 2 },
    { "match": "first and foremost", "fix": "first", "category": "filler", "weight": 3 },
    { "match": "last but not least", "fix": "finally", "category": "filler", "weight": 3 },
    { "match": "in the realm of", "fix": "in", "category": "filler", "weight": 4 },
    { "match": "when it comes to", "fix": null, "category": "filler", "weight": 2 },
    { "match": "in today's digital age", "fix": null, "category": "significance", "weight": 5 },
    { "match": "in today's fast-paced", "fix": null, "category": "significance", "weight": 5 },
    { "match": "in today's rapidly evolving", "fix": null, "category": "significance", "weight": 5 },
    { "match": "in a world where", "fix": null, "category": "significance", "weight": 4 },
    { "match": "plays a crucial role", "fix": null, "category": "significance", "weight": 5 },
    { "match": "plays a vital role", "fix": null, "category": "significance", "weight": 5 },
    { "match": "harness the power of", "fix": null, "category": "significance", "weight": 5 },
    { "match": "embark on a journey", "fix": null, "category": "significance", "weight": 5 },
    { "match": "paradigm shift", "fix": null, "category": "significance", "weight": 4 },
    { "match": "stands as a testament", "fix": null, "category": "significance", "weight": 5 },
    { "match": "marking a pivotal moment", "fix": null, "category": "significance", "weight": 5 },
    { "match": "paving the way", "fix": null, "category": "significance", "weight": 3 },
    { "match": "deep dive", "fix": "analysis", "category": "jargon", "weight": 3 },
    { "match": "move the needle", "fix": null, "category": "jargon", "weight": 3 },
    { "match": "low-hanging fruit", "fix": null, "category": "jargon", "weight": 3 },
    { "match": "pain points", "fix": "problems", "category": "jargon", "weight": 3 },
    { "match": "circle back", "fix": null, "category": "jargon", "weight": 3 },
    { "match": "double-click on", "fix": null, "category": "jargon", "weight": 3 },
    { "match": "best practices", "fix": null, "category": "jargon", "weight": 2 },
    { "match": "thought leader", "fix": null, "category": "jargon", "weight": 3 },
    { "match": "north star", "fix": null, "category": "jargon", "weight": 3 },
    { "match": "table stakes", "fix": null, "category": "jargon", "weight": 3 },
    { "match": "lean into", "fix": null, "category": "jargon", "weight": 2 },
    { "match": "state-of-the-art", "fix": null, "category": "promotional", "weight": 3 },
    { "match": "world-class", "fix": null, "category": "promotional", "weight": 3 },
    { "match": "must-visit", "fix": null, "category": "promotional", "weight": 4 },
    { "match": "breathtaking", "fix": null, "category": "promotional", "weight": 4 },
    { "match": "rich cultural heritage", "fix": null, "category": "promotional", "weight": 4 },
    { "match": "commitment to excellence", "fix": null, "category": "promotional", "weight": 4 },
    { "match": "in the heart of", "fix": null, "category": "promotional", "weight": 3 },
    { "match": "the possibilities are endless", "fix": null, "category": "conclusion", "weight": 4 }
  ],
  "regex": [
    {
      "id": "em-dash",
      "pattern": "\\u2014|\\u2013|\\s--\\s",
      "category": "style",
      "weight": 2,
      "note": "Replace with a period, comma, colon, or parentheses. En dashes in numeric ranges become hyphens."
    },
    {
      "id": "curly-double-quotes",
      "pattern": "[\\u201C\\u201D]",
      "category": "style",
      "weight": 1,
      "note": "English-only, weak signal; most editors auto-curl. Skipped for Korean, where curly quotes are the standard (newspaper corpus: straight quotes 0)."
    },
    {
      "id": "emoji",
      "pattern": "[\\u2600-\\u27BF\\u2B00-\\u2BFF]|\\uD83C[\\uDF00-\\uDFFF]|\\uD83D[\\uDC00-\\uDFFF]|\\uD83E[\\uDD00-\\uDDFF]",
      "category": "style",
      "weight": 2,
      "note": "Emojis decorating professional prose."
    },
    {
      "id": "unicode-arrow",
      "pattern": "\\u2192|\\u21D2",
      "category": "style",
      "weight": 2,
      "note": "Unicode arrows. Use -> or plain text."
    },
    {
      "id": "negative-parallelism",
      "pattern": "\\bnot (?:just|only|merely)\\b[^.!?\\n]{0,80}?\\bbut\\b",
      "category": "language",
      "weight": 3,
      "note": "It's not just X, but Y. State Y directly."
    },
    {
      "id": "its-not-x-its-y",
      "pattern": "\\b(?:it|this|that)['\\u2019]s not [^.!?\\n]{2,60}[.,;] (?:it|this|that)['\\u2019]s\\b",
      "category": "language",
      "weight": 4,
      "note": "Setup/reveal contrast formula. The single most-cited AI tell."
    },
    {
      "id": "question-isnt",
      "pattern": "\\bthe (?:question|answer|problem|point|issue) (?:isn['\\u2019]t|is not)\\b",
      "category": "language",
      "weight": 4,
      "note": "Rhetorical misdirection. State the point."
    },
    {
      "id": "negative-listing",
      "pattern": "\\bnot an? [^.!?\\n]{2,40}\\. not an? [^.!?\\n]{2,40}\\.",
      "category": "rhetoric",
      "weight": 3,
      "note": "Rhetorical striptease: listing what something is not."
    },
    {
      "id": "ing-tail",
      "pattern": ",\\s+(?:highlighting|underscoring|emphasizing|showcasing|reflecting|symbolizing|ensuring|fostering|demonstrating|illustrating|solidifying|cementing|signaling|contributing|cultivating|encompassing)\\b",
      "category": "content",
      "weight": 4,
      "note": "Present-participle tail adding fake depth."
    },
    {
      "id": "copula-avoidance",
      "pattern": "\\b(?:serves as|stands as|boasts)\\b",
      "category": "language",
      "weight": 3,
      "note": "Use is/has."
    },
    {
      "id": "vague-attribution",
      "pattern": "\\b(?:experts (?:believe|argue|say|agree)|studies show|research suggests|industry reports suggest|observers have (?:cited|noted)|some critics argue|it is believed that|it is widely (?:believed|regarded))\\b",
      "category": "content",
      "weight": 4,
      "note": "Name a real source or cut the claim."
    },
    {
      "id": "chatbot-artifact",
      "pattern": "\\b(?:i hope this helps|great question|excellent point|let me know if|would you like me to|feel free to|don['\\u2019]t hesitate to|happy to help|you['\\u2019]re absolutely right|is there anything else|certainly!|of course!)\\b",
      "category": "communication",
      "weight": 5,
      "note": "Chatbot correspondence pasted as content."
    },
    {
      "id": "cutoff-disclaimer",
      "pattern": "\\b(?:as of my last (?:training|knowledge)|knowledge cutoff|while specific details are (?:limited|scarce)|based on available information|maintains a low profile|keeps personal details private)\\b",
      "category": "communication",
      "weight": 4,
      "note": "Cutoff disclaimers and speculative gap-filling."
    },
    {
      "id": "citation-markup-leak",
      "pattern": "cite\\w*turn\\d+\\w*|oaicite|contentReference|oai_citation|utm_source=(?:chatgpt|openai|copilot|perplexity)",
      "category": "communication",
      "weight": 5,
      "note": "Tool citation markup or UTM leak. Strip it."
    },
    {
      "id": "placeholder",
      "pattern": "\\[(?:your name|insert[^\\]]*|recipient|topic|company name|x{2,})\\]|20\\d\\d-XX-XX",
      "flags": "gi",
      "category": "communication",
      "weight": 5,
      "note": "Unfilled template placeholder."
    },
    {
      "id": "hedging-stack",
      "pattern": "\\b(?:could|may|might) (?:potentially|possibly|perhaps)\\b|\\b(?:potentially|arguably) (?:possibly|perhaps)\\b",
      "category": "filler",
      "weight": 3,
      "note": "One qualifier per claim."
    },
    {
      "id": "generic-conclusion",
      "pattern": "\\b(?:the future looks bright|exciting times lie ahead|only time will tell|the possibilities are endless|poised for growth|watch this space|journey toward excellence|step in the right direction)\\b",
      "category": "conclusion",
      "weight": 4,
      "note": "End on the last concrete fact instead."
    },
    {
      "id": "signposted-conclusion",
      "pattern": "\\b(?:in conclusion|to sum up|in summary|to summarize)\\b",
      "category": "conclusion",
      "weight": 3,
      "note": "Competent writing does not announce its own conclusion."
    },
    {
      "id": "significance-inflation",
      "pattern": "\\b(?:marking a pivotal|(?:is|as) a testament to|serves as a reminder|underscor(?:es|ing) the (?:importance|significance)|reflects broader|setting the stage for|key turning point|evolving landscape|indelible mark|deeply rooted)\\b",
      "category": "content",
      "weight": 4,
      "note": "Puffed-up importance claims."
    },
    {
      "id": "throat-clearing",
      "pattern": "\\b(?:here['\\u2019]s the thing|here['\\u2019]s what you need to know|here['\\u2019]s the kicker|let['\\u2019]s dive in|let['\\u2019]s explore|let['\\u2019]s break (?:this|it) down|let['\\u2019]s unpack|without further ado|let that sink in|make no mistake|the uncomfortable truth)\\b",
      "category": "rhetoric",
      "weight": 4,
      "note": "Announcing the point instead of making it."
    },
    {
      "id": "pedagogical",
      "pattern": "\\b(?:think of it (?:as|like)|imagine a world where)\\b",
      "category": "rhetoric",
      "weight": 3,
      "note": "Patronizing analogy / futurism opener."
    },
    {
      "id": "authority-trope",
      "pattern": "\\b(?:at its core|the real question is|what really matters|the heart of the matter|the deeper issue)\\b",
      "category": "rhetoric",
      "weight": 3,
      "note": "Fake depth before an ordinary point."
    },
    {
      "id": "vague-declarative",
      "pattern": "\\bthe (?:implications|stakes|consequences|reasons) are (?:significant|high|real|structural|profound|far-reaching)\\b",
      "category": "rhetoric",
      "weight": 4,
      "note": "Name the specific implication or cut."
    },
    {
      "id": "false-agency",
      "pattern": "\\b(?:the (?:data|numbers) tells? us|the market rewards|the decision emerge[sd]|the culture shift(?:s|ed)|the conversation move[sd] toward)\\b",
      "category": "rhetoric",
      "weight": 3,
      "note": "Name the human doing the thing."
    },
    {
      "id": "despite-challenges",
      "pattern": "\\bdespite (?:these|its|the) (?:challenges|obstacles|difficulties)\\b",
      "category": "content",
      "weight": 4,
      "note": "Formulaic acknowledge-and-dismiss beat."
    },
    {
      "id": "self-posed-question",
      "pattern": "\\bthe (?:result|catch|kicker|worst part|best part|scary part)\\?",
      "flags": "gi",
      "category": "rhetoric",
      "weight": 4,
      "note": "Self-posed question answered for drama."
    },
    {
      "id": "inline-header-list",
      "pattern": "^\\s*[-*]\\s+\\*\\*[^*\\n]{2,60}\\*\\*:",
      "flags": "gim",
      "category": "style",
      "weight": 3,
      "note": "Bolded label bullets. Convert to prose or a plain list."
    },
    {
      "id": "oxford-triple",
      "pattern": "\\b\\w+, \\w+, and \\w+\\b",
      "category": "language",
      "weight": 1,
      "note": "Rule of three. Often legitimate; counted lightly, matters in clusters."
    }
  ],
  "korean": {
    "note": "Korean-language slop markers. sloplint counts these when Hangul is detected. Weights calibrated against a 5,386-sentence human corpus (NIKLUGE-2025): markers that appear often in natural human writing get low weight. Most markers hit 0-2 times per 5,386 human sentences; 원활한/강력한 are the exceptions (common human adjectives) so they carry weight 1. See references/korean-baseline.md.",
    "phrases": [
      { "match": "결론적으로", "category": "conclusion", "weight": 3 },
      { "match": "요약하자면", "category": "conclusion", "weight": 3 },
      { "match": "무엇보다도", "category": "filler", "weight": 2 },
      { "match": "다시 말해", "category": "filler", "weight": 2 },
      { "match": "중요한 것은", "category": "rhetoric", "weight": 2 },
      { "match": "주목할 만한 점은", "category": "rhetoric", "weight": 3 },
      { "match": "라고 할 수 있습니다", "category": "filler", "weight": 2 },
      { "match": "매우 중요한", "category": "significance", "weight": 2 },
      { "match": "핵심적인 역할", "category": "significance", "weight": 3 },
      { "match": "빠르게 변화하는", "category": "significance", "weight": 3 },
      { "match": "오늘날", "category": "significance", "weight": 2 },
      { "match": "~에 대해 알아보겠습니다", "category": "signposting", "weight": 3 },
      { "match": "함께 살펴보겠습니다", "category": "signposting", "weight": 3 },
      { "match": "도움이 되셨기를 바랍니다", "category": "communication", "weight": 4 },
      { "match": "궁금한 점이 있으시면", "category": "communication", "weight": 4 },
      { "match": "혁신적", "category": "promotional", "weight": 2 },
      { "match": "원활한", "category": "promotional", "weight": 1 },
      { "match": "강력한", "category": "promotional", "weight": 1 },
      { "match": "구체 정보", "category": "translationese", "weight": 2 },
      { "match": "구체 수치", "category": "translationese", "weight": 2 },
      { "match": "구체 사례", "category": "translationese", "weight": 2 },
      { "match": "구체 방안", "category": "translationese", "weight": 2 },
      { "match": "구체 내용", "category": "translationese", "weight": 2 },
      { "match": "구체 계획", "category": "translationese", "weight": 2 }
    ]
  }
}
